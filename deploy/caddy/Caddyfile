# Caddy — единый edge-proxy. Автоматический HTTPS (Let's Encrypt, HTTP-01).
# Хосты и параметры берутся из переменных окружения (env_file app.env).
# Маршрут /api/* → backend окружения; всё остальное → web (статика PWA).
{
	email {$ACME_EMAIL}
	# Для тестов LE раскомментируйте staging-CA, чтобы не упереться в лимиты:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ── STAGING (ветка test) ────────────────────────────────────────────────
{$STAGING_HOST} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy backend-staging:8080
	}
	handle {
		reverse_proxy web-staging:80
	}
}

# ── PRODUCTION (ветка release, in-place) ─────────────────────────────────
{$PROD_HOST} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy backend-production:8080
	}
	handle {
		reverse_proxy web-production:80
	}
}

# ── MONITORING (Grafana — у неё своя авторизация) ────────────────────────
{$MONITORING_HOST} {
	encode zstd gzip
	reverse_proxy grafana:3000
}
