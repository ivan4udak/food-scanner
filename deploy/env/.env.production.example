# PRODUCTION — секреты. На сервере: /opt/foodscanner/production/app.env (chmod 600).
# Используется обоими цветами blue/green. НЕ коммитить реальные значения.
# DB_USER/PASSWORD должны совпадать с POSTGRES_*.

# ── Postgres (контейнер postgres-production) ──
POSTGRES_DB=foodscanner
POSTGRES_USER=foodscanner
POSTGRES_PASSWORD=CHANGE_ME_prod_db_password

# ── Backend ──
DB_URL=jdbc:postgresql://postgres:5432/foodscanner
DB_USER=foodscanner
DB_PASSWORD=CHANGE_ME_prod_db_password
# Общий MinIO (стек minio). ACCESS/SECRET = MINIO_ROOT_USER/PASSWORD из minio/app.env.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=foodscanner
MINIO_SECRET_KEY=CHANGE_ME_shared_minio_password
MINIO_BUCKET=food-images-production
JWT_SECRET=CHANGE_ME_prod_jwt_secret_min_32_chars_long
ADMIN_PASSWORD=CHANGE_ME_prod_admin_password
HEALTH_SHOW_DETAILS=never

# В проде минимум логов.
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
