# CADDY — на сервере: /opt/foodscanner/caddy/app.env (chmod 600).
# Поддомены DuckDNS должны указывать A-записью на IP сервера.

ACME_EMAIL=you@example.com

STAGING_HOST=foodscanner-staging.duckdns.org
STABLE_HOST=foodscanner-stable.duckdns.org
PROD_HOST=foodscanner.duckdns.org
MONITORING_HOST=foodscanner-monitoring.duckdns.org

# Basic-auth для Grafana через Caddy.
MONITORING_BASICAUTH_USER=admin
# bcrypt-хэш пароля. Сгенерировать:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'ВАШ_ПАРОЛЬ'
MONITORING_BASICAUTH_HASH=$2a$14$REPLACE_WITH_REAL_BCRYPT_HASH
