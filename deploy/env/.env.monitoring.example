# MONITORING — на сервере: /opt/foodscanner/monitoring/app.env (chmod 600).
# Имена переменных = как ждёт Grafana (передаются напрямую через env_file).

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_grafana_admin
# Должно совпадать с MONITORING_HOST в caddy/app.env.
GF_SERVER_ROOT_URL=https://foodscanner-mon.duckdns.org
