# STABLE (ветка main) — на сервере: /opt/foodscanner/stable/app.env (chmod 600).
# DB_USER/PASSWORD = POSTGRES_*. MINIO_ACCESS/SECRET = root общего minio (minio/app.env).

# ── Postgres (контейнер postgres-stable) ──
POSTGRES_DB=foodscanner
POSTGRES_USER=foodscanner
POSTGRES_PASSWORD=CHANGE_ME_stable_db_password

# ── Backend ──
DB_URL=jdbc:postgresql://postgres:5432/foodscanner
DB_USER=foodscanner
DB_PASSWORD=CHANGE_ME_stable_db_password
MINIO_ENDPOINT=http://minio-shared:9000
MINIO_ACCESS_KEY=foodscanner
MINIO_SECRET_KEY=CHANGE_ME_shared_minio_password
MINIO_BUCKET=food-images-stable
JWT_SECRET=CHANGE_ME_stable_jwt_secret_min_32_chars_long
ADMIN_PASSWORD=CHANGE_ME_stable_admin_password
HEALTH_SHOW_DETAILS=when-authorized

LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
