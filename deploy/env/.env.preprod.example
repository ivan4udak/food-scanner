# PRE-PRODUCTION — секреты. На сервере: /opt/foodscanner/preprod/app.env (chmod 600).
# НЕ коммитить реальные значения. DB_USER/PASSWORD должны совпадать с POSTGRES_*.

# ── Postgres (контейнер postgres-preprod) ──
POSTGRES_DB=foodscanner
POSTGRES_USER=foodscanner
POSTGRES_PASSWORD=CHANGE_ME_preprod_db_password

# ── MinIO (контейнер minio-preprod) ──
MINIO_ROOT_USER=foodscanner
MINIO_ROOT_PASSWORD=CHANGE_ME_preprod_minio_password

# ── Backend ──
DB_URL=jdbc:postgresql://postgres:5432/foodscanner
DB_USER=foodscanner
DB_PASSWORD=CHANGE_ME_preprod_db_password
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=foodscanner
MINIO_SECRET_KEY=CHANGE_ME_preprod_minio_password
MINIO_BUCKET=food-images
JWT_SECRET=CHANGE_ME_preprod_jwt_secret_min_32_chars_long
ADMIN_PASSWORD=CHANGE_ME_preprod_admin_password
HEALTH_SHOW_DETAILS=when-authorized

LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
